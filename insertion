#include <stdio.h>

void imprimirVetor(int vetor[], int tamanho){
    for( int i = 0; i<tamanho; i++){
        printf("%d|", vetor[i]);
    }
    printf("\n");
}

void insertionSort(int vetor[], int tamanho){
    int i, j, chave;
    
    for(i = 1; i<tamanho; i++){
        chave = vetor[i];
        j = i-1;
        while(j>=0 && vetor[j]<chave){
            vetor[j+1] = vetor[j];
            j-=1;
        }
        vetor[j+1] = chave;
    }
    imprimirVetor(vetor, tamanho);
}

int main(){
    int meuVetor[] = {50, 70, 30, 40, 20, 80, 5, 60, 90, 10};
    int tam = sizeof(meuVetor)/sizeof(meuVetor[0]);

    insertionSort(meuVetor, tam);
}
